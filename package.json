{
  "name": "trackaos-pad",
  "version": "0.1.0",
  "description": "Minimal Kaoss Pad–like browser music tool — drum/bass loops + XY synth pad",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prettify": "prettier --write .",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm run build"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1"
  }
}
